\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apartpaper}[2026/11/14 One-column research sprint paper]

% This is a reusable Apart sprint layout, not a conference style file.
% Check the current sprint's submission rules before using it.
\RequirePackage[letterpaper,margin=0.85in,footskip=0.42in]{geometry}
\RequirePackage{fontspec}
\IfFontExistsTF{STIX Two Text}
  {\setmainfont{STIX Two Text}}
  {\IfFontExistsTF{TeX Gyre Termes}
    {\setmainfont{TeX Gyre Termes}}
    {\IfFontExistsTF{Times New Roman}
      {\setmainfont{Times New Roman}}
      {\setmainfont{Latin Modern Roman}}}}
\IfFontExistsTF{Avenir Next}
  {\setsansfont{Avenir Next}}
  {\IfFontExistsTF{TeX Gyre Heros}
    {\setsansfont{TeX Gyre Heros}}
    {\IfFontExistsTF{Arial}
      {\setsansfont{Arial}}
      {\setsansfont{Latin Modern Sans}}}}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{caption}
\RequirePackage{titlesec}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage[section]{placeins}

\definecolor{ApartInk}{HTML}{20252B}
\definecolor{ApartLink}{HTML}{245A7A}
\color{ApartInk}
\hypersetup{
  colorlinks=true,
  linkcolor=ApartLink,
  citecolor=ApartLink,
  urlcolor=ApartLink,
  pdfborder={0 0 0}
}
\urlstyle{same}

\renewcommand{\normalsize}{\fontsize{10.2pt}{12.9pt}\selectfont}
\normalsize
\setlength{\parindent}{1.15em}
\setlength{\parskip}{0pt plus 0.5pt}
\frenchspacing
\raggedbottom
\emergencystretch=1.5em
\setlist{topsep=3pt,itemsep=2pt,parsep=0pt}
\renewcommand{\topfraction}{0.84}
\renewcommand{\textfraction}{0.12}
\renewcommand{\floatpagefraction}{0.75}

\titleformat{\section}
  {\normalfont\sffamily\fontsize{12.0pt}{14.8pt}\selectfont\bfseries}
  {\thesection}{0.62em}{}
\titlespacing*{\section}{0pt}{15pt plus 3pt minus 2pt}{6pt}
\titleformat{\subsection}
  {\normalfont\sffamily\fontsize{10.4pt}{13.2pt}\selectfont\bfseries}
  {\thesubsection}{0.55em}{}
\titlespacing*{\subsection}{0pt}{11pt plus 2pt minus 1pt}{4pt}

\captionsetup{
  font={small},
  labelfont=bf,
  labelsep=period,
  justification=raggedright,
  singlelinecheck=false,
  skip=5pt
}
\renewcommand{\thefigure}{\arabic{figure}}
\renewcommand{\thetable}{\arabic{table}}

\newcommand{\paperhead}[3]{%
  \begin{center}
    {\rmfamily\fontsize{18.5pt}{22.5pt}\selectfont\bfseries #1\par}
    \vspace{8pt}
    {\fontsize{10.5pt}{13pt}\selectfont #2\par}
    {\fontsize{9.6pt}{12pt}\selectfont #3\par}
  \end{center}
  \vspace{10pt}
}

% A modest inset sets the abstract apart on the one-column page.
\newenvironment{paperabstract}{%
  \par\vspace{4pt}
  \begin{center}
    {\sffamily\fontsize{10.5pt}{13pt}\selectfont\bfseries Abstract}
  \end{center}
  \vspace{-4pt}
  \begingroup
  \leftskip=0.4in
  \rightskip=0.4in
  \parindent=0pt
  \fontsize{10pt}{12.2pt}\selectfont
  \noindent\ignorespaces
}{%
  \par\endgroup
  \vspace{9pt}
}

\newcommand{\paperbackmatter}[1]{%
  \section*{#1}
  \addcontentsline{toc}{section}{#1}
}
